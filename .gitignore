# Ignore virtual environments
venv/
.env

# Python compilation files
__pycache__/
*.pyc
*.pyo
*.pyd

# Streamlit specific (keep config.toml for deployment)
.streamlit/secrets.toml

# Database files
*.db
*.sqlite3

# Demo data (optional if large, but CSVs usually fine, ignoring large data dirs)
data/*.db

# IDEs and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
node_modules/
# web/dist/ — kept in repo for Render deployment (no npm on Render Python runtime)
web/node_modules/
